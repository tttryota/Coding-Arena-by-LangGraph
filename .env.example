# SQLITE_PATH=data/app.db
# SCORE_THRESHOLD_NOT_STARTED=25
# SCORE_THRESHOLD_INSUFFICIENT=50
# SCORE_THRESHOLD_PARTIAL=75
# SESSION_MAX_QUESTIONS=20

# Langfuse is disabled by default. Run scripts/init-langfuse-env.sh to
# generate local-only credentials and enable the observability profile.
# LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=local
# LANGFUSE_RELEASE=dev
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_CAPTURE_CONTENT=true
