VAULT_PATH=/path/to/your/obsidian/vault

# Docker 環境ではデフォルトで動作（CHROMADB_HOST は docker-compose.yml で上書き）
# ローカル開発時のみ以下を変更:
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000
# SQLITE_PATH=data/app.db
# BATCH_INTERVAL_MINUTES=15
# SCORE_THRESHOLD_NOT_STARTED=25
# SCORE_THRESHOLD_INSUFFICIENT=50
# SCORE_THRESHOLD_PARTIAL=75
# SESSION_MAX_QUESTIONS=20
